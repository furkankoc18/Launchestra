    },
    "Girişte başlatma kapatıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login is off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişte başlatma kapatıldı."
          }
        }
      }
    },
    "Kayıt oluşturuldu; etkinleşmesi için macOS onayı gerekiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login item was registered and needs macOS approval."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt oluşturuldu; etkinleşmesi için macOS onayı gerekiyor."
          }
