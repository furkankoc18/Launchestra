    "Launchestra oturum açıldığında kendiliğinden başlamaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchestra does not start automatically when you sign in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchestra oturum açıldığında kendiliğinden başlamaz."
          }
        }
      }
    },
    "Launchestra sonraki oturum açılışlarında macOS tarafından başlatılabilir. Hiçbir profil otomatik çalıştırılmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS may start Launchestra at future logins. No profile runs automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchestra sonraki oturum açılışlarında macOS tarafından başlatılabilir. Hiçbir profil otomatik çalıştırılmaz."
          }
        }
      }
    },
    "macOS onayı gerekiyor. Sistem Ayarları’ndaki Giriş Öğeleri bölümünde Launchestra’ya izin ver.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS approval is required. Allow Launchestra in Login Items in System Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS onayı gerekiyor. Sistem Ayarları’ndaki Giriş Öğeleri bölümünde Launchestra’ya izin ver."
          }
        }
      }
    },
    "macOS bu uygulama paketini giriş öğesi olarak bulamadı. Uygulamayı Applications klasörüne taşıdıktan sonra yeniden dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not find this app bundle as a login item. Move it to Applications and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bu uygulama paketini giriş öğesi olarak bulamadı. Uygulamayı Applications klasörüne taşıdıktan sonra yeniden dene."
          }
        }
      }
    },
    "Girişte başlatma açıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login is on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişte başlatma açıldı."
          }
        }
