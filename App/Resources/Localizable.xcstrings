          "stringUnit": {
            "state": "translated",
            "value": "Giriş öğesi uygulama paketinde bulunamadı."
          }
        }
      }
    },
    "Girişte başlatma açılamadı. macOS durumunu kontrol edip yeniden dene.": {
      "localizations": {
