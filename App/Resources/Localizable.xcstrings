            "state": "translated",
            "value": "Ana profil dosyası bulunamadı. Kullanılabilir doğrulanmış bir yedek var."
          }
        }
      }
    },
    "Ana profil dosyası bulunamadı; mevcut yedek de doğrulanamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main profile file is missing and the existing backup could not be verified."
