        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştırma zaman aşımına uğradı."
          }
        }
      }
    },
    "Bu profil dosyası daha yeni veya desteklenmeyen şema sürümünü kullanıyor (v%d). Uyumlu Launchestra sürümünü kullanabilir ya da özgün veriyi koruyarak yeni yapılandırma oluşturabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile file uses a newer or unsupported schema version (v%d). Use a compatible Launchestra version or preserve the original data and create a new configuration."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil dosyası daha yeni veya desteklenmeyen şema sürümünü kullanıyor (v%d). Uyumlu Launchestra sürümünü kullanabilir ya da özgün veriyi koruyarak yeni yapılandırma oluşturabilirsin."
          }
        }
      }
    },
    "%d açma isteğinin tümü kabul edildi.": {
      "localizations": {
        "en": {
          "stringUnit": {
