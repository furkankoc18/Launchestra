{
  "sourceLanguage": "tr",
  "strings": {
    "Launchestra’ya Hoş Geldin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Launchestra"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchestra’ya Hoş Geldin"
          }
        }
      }
    },
    "Uygulamalarını, klasörlerini ve web adreslerini bir profilde sırala; hazır olduğunda menü çubuğundan birlikte aç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange apps, folders, and websites in a profile, then open them together from the menu bar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalarını, klasörlerini ve web adreslerini bir profilde sırala; hazır olduğunda menü çubuğundan birlikte aç."
          }
        }
      }
    },
    "Menü çubuğundaki Launchestra simgesi profillerine her zaman ulaşmanı sağlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Launchestra menu bar icon keeps your profiles within reach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğundaki Launchestra simgesi profillerine her zaman ulaşmanı sağlar."
          }
        }
      }
    },
    "İlk profilin boş başlar. Sen seçmeden uygulama, klasör veya web adresi açılmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first profile starts empty. Nothing opens until you choose it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk profilin boş başlar. Sen seçmeden uygulama, klasör veya web adresi açılmaz."
          }
        }
      }
    },
    "Global kısayol ve girişte başlatma isteğe bağlıdır; başlangıçta kapalıdır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global shortcuts and launch at login are optional and start turned off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Global kısayol ve girişte başlatma isteğe bağlıdır; başlangıçta kapalıdır."
          }
        }
      }
    },
